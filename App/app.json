{
  "expo": {
    "name": "Campeón de Sillón",
    "slug": "campeon-de-sillon",
    "scheme": "campeondesillon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131211",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "mx.campeondesillon.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a6433af-c180-4ae2-bc82-88fd295cdc03"
      }
    },
    "owner": "jesus_rodriguez"
  }
}
