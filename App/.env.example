# Variables PÚBLICAS de la app. Copia este archivo como .env y llena los valores.
# Todo lo que tenga el prefijo EXPO_PUBLIC_ queda dentro de la app y se puede extraer:
# aquí NUNCA va una clave secreta (servicio de Supabase, API-Football, Anthropic) — D14.

# URL del proyecto de Supabase (Panel > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=

# Clave pública de Supabase (publishable / anon). La seguridad la dan las políticas RLS.
EXPO_PUBLIC_SUPABASE_KEY=
