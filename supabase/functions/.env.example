# Secretos del SERVIDOR para probar las funciones en local.
# Copia este archivo como supabase/functions/.env (ignorado por git) y llena los valores.
# En el proyecto de Supabase se cargan con: npx supabase secrets set --env-file supabase/functions/.env

# Clave de API-Football (https://dashboard.api-football.com)
API_FOOTBALL_KEY=

# Clave de Anthropic para evaluar las justificaciones (F06) y para `deno task probar-prompt`
ANTHROPIC_API_KEY=
